{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/download.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    },
    "api/info.js": { "maxDuration": 30 },
    "api/mcp.js": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "headers": [
    {
      "source": "/(llms.txt|openapi.json|robots.txt)",
      "headers": [{ "key": "access-control-allow-origin", "value": "*" }]
    }
  ]
}
